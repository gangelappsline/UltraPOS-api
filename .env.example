# ─────────────────────────────── APP ───────────────────────────────
APP_NAME="UltraPOS API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ─────────────────────────────── DB ────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ultrapos
DB_USERNAME=root
DB_PASSWORD=

# ───────────────────────────── CACHE/QUEUE ─────────────────────────
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─────────────────────────────── MAIL ──────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@ultrapos.test"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────── CORS ──────────────────────────────
# Comma separated list of allowed origins, e.g.:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://pos.example.com
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_ORIGINS_PATTERNS=
CORS_SUPPORTS_CREDENTIALS=false

# ───────────────────────────── PASSPORT ────────────────────────────
# Keys are generated by: php artisan passport:keys
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
PASSPORT_PASSPHRASE=

# Filled by: php artisan passport:client --personal
PASSPORT_PERSONAL_ACCESS_CLIENT_ID=
PASSPORT_PERSONAL_ACCESS_CLIENT_SECRET=

# Filled by: php artisan passport:client --password
PASSPORT_PASSWORD_GRANT_CLIENT_ID=
PASSPORT_PASSWORD_GRANT_CLIENT_SECRET=

# Token lifetimes (minutes)
PASSPORT_ACCESS_TOKEN_TTL=1440
PASSPORT_REFRESH_TOKEN_TTL=43200
PASSPORT_PERSONAL_ACCESS_TOKEN_TTL=10080

# ──────────────────────────── L5-SWAGGER ───────────────────────────
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_API_TITLE="UltraPOS API"
L5_SWAGGER_CONST_HOST="http://localhost:8000/api/v1"
L5_SWAGGER_UI_DARK_MODE=true
L5_SWAGGER_UI_DOC_EXPANSION=list
L5_SWAGGER_UI_PERSIST_AUTHORIZATION=true

# ─────────────────────────── DEFAULT SEEDS ─────────────────────────
DEFAULT_ADMIN_NAME="System Administrator"
DEFAULT_ADMIN_EMAIL=admin@ultrapos.test
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

DEMO_BUSINESS_NAME="Demo Store"
DEMO_BUSINESS_EMAIL=demo@ultrapos.test
DEMO_BUSINESS_PASSWORD=ChangeMe123!

# ─────────────────────────── BUSINESS RULES ────────────────────────
# Loyalty points awarded per currency unit spent on a completed sale.
POS_LOYALTY_POINTS_PER_UNIT=1
# Allow sales below zero stock (emergency mode) — should stay false.
POS_ALLOW_NEGATIVE_STOCK=false

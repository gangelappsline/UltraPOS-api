# ─────────────────────────────── APP ───────────────────────────────
APP_NAME="UltraPOS API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ─────────────────────────────── DB ────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ultrapos
DB_USERNAME=root
DB_PASSWORD=

# ───────────────────────────── CACHE/QUEUE ─────────────────────────
# Redis is what docker-compose uses and what the README's `queue:work redis`
# expects. If you do not run Redis locally, switch all three to `database`:
# the skeleton migrations already create the cache/sessions/jobs tables.
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─────────────────────────────── MAIL ──────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@ultrapos.test"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────── CORS ──────────────────────────────
# Comma separated list of allowed origins, e.g.:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://pos.example.com
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_ORIGINS_PATTERNS=
CORS_SUPPORTS_CREDENTIALS=false

# ───────────────────────────── PASSPORT ────────────────────────────
# OAuth keys: php artisan passport:keys  (writes storage/oauth-*.key)
# Leave empty for file-based keys; paste the PEM contents here only when the
# storage dir is ephemeral (containers/CI), keeping newlines as literal \n.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# The personal-access and password-grant CLIENTS are database rows, not env
# values (Passport 13 dropped the .env based client config). Provision them
# with:  php artisan ultrapos:passport-clients   (the seeder does it for you)
# Token lifetimes in minutes (also feed Passport::tokensExpireIn()):
PASSPORT_ACCESS_TOKEN_TTL=1440
PASSPORT_REFRESH_TOKEN_TTL=43200
PASSPORT_PERSONAL_ACCESS_TOKEN_TTL=10080
# Route prefix of the OAuth2 endpoints, i.e. POST ${APP_URL}/oauth/token
PASSPORT_PATH=oauth

# ──────────────────────────── L5-SWAGGER ───────────────────────────
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_API_TITLE="UltraPOS API"
L5_SWAGGER_CONST_HOST="http://localhost:8000/api/v1"
L5_SWAGGER_UI_DARK_MODE=true
L5_SWAGGER_UI_DOC_EXPANSION=list
L5_SWAGGER_UI_PERSIST_AUTHORIZATION=true

# ─────────────────────────── DEFAULT SEEDS ─────────────────────────
DEFAULT_ADMIN_NAME="System Administrator"
DEFAULT_ADMIN_EMAIL=admin@ultrapos.test
DEFAULT_ADMIN_PASSWORD=ChangeMe123!

DEMO_BUSINESS_NAME="Demo Store"
DEMO_BUSINESS_EMAIL=demo@ultrapos.test
DEMO_BUSINESS_PASSWORD=ChangeMe123!

# ─────────────────────────── APP BEHAVIOUR ─────────────────────────
# Eloquent strict mode: lazy loading / non-fillable mass assignment / missing
# attributes throw. Recommended while developing, keep false for a fresh
# install and in production (it turns notices into HTTP 500s).
ULTRAPOS_STRICT_MODELS=false
# Expose the OAuth2 password grant on POST /oauth/token (Passport 13 disables
# it by default). /api/v1/auth/login works either way.
ULTRAPOS_PASSWORD_GRANT=true
# Days before a subscription ends to warn its owner.
ULTRAPOS_SUBSCRIPTION_WARNING_DAYS=7
# Fallback currency + trial length for tenants without their own values
# (per-business currency/timezone are stored on the businesses row).
ULTRAPOS_CURRENCY=USD
ULTRAPOS_TRIAL_DAYS=14

# ─────────────────────────── BUSINESS RULES ────────────────────────
# Loyalty points awarded per currency unit spent on a completed sale.
POS_LOYALTY_POINTS_PER_UNIT=1
# Allow sales below zero stock (emergency mode) — should stay false.
POS_ALLOW_NEGATIVE_STOCK=false
